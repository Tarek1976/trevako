# GEMINI_API_KEY: Optional. If provided, enables Gemini AI generation and analysis.
# If omitted or if project lacks API key creation permissions, Dewan utilizes
# its built-in rule-based administrative drafting and legal synthesis engine.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=
